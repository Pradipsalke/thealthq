# The ALT HQ - Apache URL Rewriting
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# 1. External redirect: strip .php extension from browser URL (GET/HEAD requests only)
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 2. Existing files and directories: serve directly (images, css, js, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. Internal rewrite: resolve extensionless URLs to their .php files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [L,QSA]
</IfModule>
